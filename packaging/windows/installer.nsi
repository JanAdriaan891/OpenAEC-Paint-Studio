Unicode true
!include "MUI2.nsh"
Name "OpenAEC Paint Studio ${NUMBER}"
OutFile "${OUTPUT}"
InstallDir "$LOCALAPPDATA\OpenAEC Paint Studio"
InstallDirRegKey HKCU "Software\OpenAEC Paint Studio" ""
RequestExecutionLevel user
SetCompressor /SOLID lzma
!define MUI_ICON "..\icons\icon.ico"
!define MUI_UNICON "..\icons\icon.ico"
!define UNINST "Software\Microsoft\Windows\CurrentVersion\Uninstall\OpenAEC Paint Studio"
!define CAP "Software\OpenAEC\PaintStudio\Capabilities"
!define CLASS "Software\Classes\OpenAEC.PaintStudio.Image"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "Dutch"
!insertmacro MUI_LANGUAGE "English"
VIProductVersion "${NUMBER}.0"
VIAddVersionKey /LANG=${LANG_ENGLISH} "ProductName" "OpenAEC Paint Studio"
VIAddVersionKey /LANG=${LANG_ENGLISH} "CompanyName" "OpenAEC contributors"
VIAddVersionKey /LANG=${LANG_ENGLISH} "FileVersion" "${NUMBER}"
VIAddVersionKey /LANG=${LANG_ENGLISH} "ProductVersion" "${NUMBER}"
VIAddVersionKey /LANG=${LANG_ENGLISH} "FileDescription" "OpenAEC Paint Studio native Rust installer"
!macro Associate EXT
 WriteRegStr HKCU "Software\Classes\.${EXT}\OpenWithProgids" "OpenAEC.PaintStudio.Image" ""
 WriteRegStr HKCU "${CAP}\FileAssociations" ".${EXT}" "OpenAEC.PaintStudio.Image"
 WriteRegStr HKCU "Software\Classes\Applications\openaec-paint-studio.exe\SupportedTypes" ".${EXT}" ""
!macroend
!macro RemoveAssociation EXT
 DeleteRegValue HKCU "Software\Classes\.${EXT}\OpenWithProgids" "OpenAEC.PaintStudio.Image"
!macroend
Section "Install"
 SetOutPath "$INSTDIR"
 File "${SOURCE}\openaec-paint-studio.exe"
 File "${SOURCE}\paint-api.exe"
 File "${SOURCE}\paint-mcp.exe"
 File "..\icons\icon.ico"
 SetOutPath "$INSTDIR\licenses"
 File /r "${LEGAL}\*"
 WriteUninstaller "$INSTDIR\uninstall.exe"
 CreateShortcut "$SMPROGRAMS\OpenAEC Paint Studio.lnk" "$INSTDIR\openaec-paint-studio.exe" "" "$INSTDIR\icon.ico"
 WriteRegStr HKCU "Software\OpenAEC Paint Studio" "" "$INSTDIR"
 WriteRegStr HKCU "${UNINST}" "DisplayName" "OpenAEC Paint Studio"
 WriteRegStr HKCU "${UNINST}" "DisplayVersion" "${NUMBER}"
 WriteRegStr HKCU "${UNINST}" "Publisher" "OpenAEC contributors"
 WriteRegStr HKCU "${UNINST}" "DisplayIcon" "$INSTDIR\icon.ico"
 WriteRegStr HKCU "${UNINST}" "UninstallString" '$\"$INSTDIR\uninstall.exe$\"'
 WriteRegDWORD HKCU "${UNINST}" "NoModify" 1
 WriteRegDWORD HKCU "${UNINST}" "NoRepair" 1
 WriteRegStr HKCU "${CLASS}" "" "OpenAEC Paint Studio image"
 WriteRegStr HKCU "${CLASS}\DefaultIcon" "" '$\"$INSTDIR\icon.ico$\",0'
 WriteRegStr HKCU "${CLASS}\shell\open\command" "" '$\"$INSTDIR\openaec-paint-studio.exe$\" $\"%1$\"'
 WriteRegStr HKCU "Software\Classes\Applications\openaec-paint-studio.exe\shell\open\command" "" '$\"$INSTDIR\openaec-paint-studio.exe$\" $\"%1$\"'
 WriteRegStr HKCU "${CAP}" "ApplicationName" "OpenAEC Paint Studio"
 WriteRegStr HKCU "${CAP}" "ApplicationDescription" "Native Rust image editor"
 WriteRegStr HKCU "Software\RegisteredApplications" "OpenAEC Paint Studio" "${CAP}"
 !insertmacro Associate "png"
 !insertmacro Associate "jpg"
 !insertmacro Associate "jpeg"
 !insertmacro Associate "webp"
 !insertmacro Associate "gif"
 !insertmacro Associate "bmp"
 !insertmacro Associate "tif"
 !insertmacro Associate "tiff"
 !insertmacro Associate "svg"
 !insertmacro Associate "svgz"
 !insertmacro Associate "heic"
 !insertmacro Associate "heif"
 !insertmacro Associate "avif"
 !insertmacro Associate "psd"
 !insertmacro Associate "psb"
 !insertmacro Associate "ico"
 !insertmacro Associate "tga"
 !insertmacro Associate "jp2"
 !insertmacro Associate "jxl"
 !insertmacro Associate "dng"
 !insertmacro Associate "raw"
 !insertmacro Associate "cr2"
 !insertmacro Associate "cr3"
 !insertmacro Associate "nef"
 !insertmacro Associate "arw"
 !insertmacro Associate "orf"
 !insertmacro Associate "rw2"
 !insertmacro Associate "ifcx"
 !insertmacro Associate "ifcxb"
 System::Call 'shell32::SHChangeNotify(i 0x8000000, i 0, p 0, p 0)'
SectionEnd
Section "Uninstall"
 Delete "$SMPROGRAMS\OpenAEC Paint Studio.lnk"
 Delete "$INSTDIR\openaec-paint-studio.exe"
 Delete "$INSTDIR\paint-api.exe"
 Delete "$INSTDIR\paint-mcp.exe"
 Delete "$INSTDIR\icon.ico"
 Delete "$INSTDIR\uninstall.exe"
 RMDir /r "$INSTDIR\licenses"
 RMDir "$INSTDIR"
 DeleteRegKey HKCU "${CLASS}"
 DeleteRegKey HKCU "${CAP}"
 DeleteRegKey HKCU "Software\Classes\Applications\openaec-paint-studio.exe"
 DeleteRegKey HKCU "Software\OpenAEC Paint Studio"
 DeleteRegKey HKCU "${UNINST}"
 DeleteRegValue HKCU "Software\RegisteredApplications" "OpenAEC Paint Studio"
 !insertmacro RemoveAssociation "png"
 !insertmacro RemoveAssociation "jpg"
 !insertmacro RemoveAssociation "jpeg"
 !insertmacro RemoveAssociation "webp"
 !insertmacro RemoveAssociation "gif"
 !insertmacro RemoveAssociation "bmp"
 !insertmacro RemoveAssociation "tif"
 !insertmacro RemoveAssociation "tiff"
 !insertmacro RemoveAssociation "svg"
 !insertmacro RemoveAssociation "svgz"
 !insertmacro RemoveAssociation "heic"
 !insertmacro RemoveAssociation "heif"
 !insertmacro RemoveAssociation "avif"
 !insertmacro RemoveAssociation "psd"
 !insertmacro RemoveAssociation "psb"
 !insertmacro RemoveAssociation "ico"
 !insertmacro RemoveAssociation "tga"
 !insertmacro RemoveAssociation "jp2"
 !insertmacro RemoveAssociation "jxl"
 !insertmacro RemoveAssociation "dng"
 !insertmacro RemoveAssociation "raw"
 !insertmacro RemoveAssociation "cr2"
 !insertmacro RemoveAssociation "cr3"
 !insertmacro RemoveAssociation "nef"
 !insertmacro RemoveAssociation "arw"
 !insertmacro RemoveAssociation "orf"
 !insertmacro RemoveAssociation "rw2"
 !insertmacro RemoveAssociation "ifcx"
 !insertmacro RemoveAssociation "ifcxb"
 System::Call 'shell32::SHChangeNotify(i 0x8000000, i 0, p 0, p 0)'
SectionEnd
